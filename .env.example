# Copy to .env and fill in. Create the app at https://www.dropbox.com/developers/apps
# (Scoped access, Full Dropbox; scopes: account_info.read, files.metadata.read/write,
# files.content.read/write).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Obtained once via the OAuth code flow with token_access_type=offline.
DROPBOX_REFRESH_TOKEN=
# Optional: Dropbox folder KOReader pulls from (default /Kindle).
DROPBOX_KINDLE_FOLDER=

# Inbox the Kindle syncs from: webdav (Jianguoyun) or dropbox.
KINDLE_INBOX=webdav
WEBDAV_URL=https://dav.jianguoyun.com/dav
WEBDAV_USERNAME=
# Jianguoyun: Account -> Security -> Third-party apps -> Add app -> Generate password.
WEBDAV_PASSWORD=
